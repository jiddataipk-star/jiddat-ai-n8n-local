# Copy to .env and fill in. .env is git-ignored and must never be committed.
# README.md "First start" has a one-line command that does this for you.

# REQUIRED. Encrypts every credential saved in n8n. 64 hex characters.
# Generate once, store a copy in your password manager, never change it.
# Without this exact value, saved credentials cannot be decrypted anywhere.
N8N_ENCRYPTION_KEY=

# Timezone used by Schedule triggers, date functions and logs.
GENERIC_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi

# Port on this machine. Change if 5678 is already in use, and update
# N8N_WEBHOOK_URL to match.
N8N_HOST_PORT=5678

# How n8n is reached from outside. Local defaults.
# Later, on a VPS with a domain and HTTPS:
#   N8N_HOST=n8n.example.com
#   N8N_PROTOCOL=https
#   N8N_WEBHOOK_URL=https://n8n.example.com/
#   N8N_PROXY_HOPS=1
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
